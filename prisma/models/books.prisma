model Books {
  id          Int    @id(map: "Book_pkey") @default(autoincrement())
  isbn        String @unique
  title       String
  author      String
  description String
  pageCount   Int
  coverUrl    String
  users_books UsersBooks[]
  books_reviews BooksReviews[]

  @@map("books")
  @@schema("public")
}
